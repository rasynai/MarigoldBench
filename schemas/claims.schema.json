{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crucible/claims/v1",
  "title": "CRUCIBLE Submission Claims v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "claim_type", "confidence", "artifact_pointers"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "claim_type": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "scope": {"type": "string"},
          "value": {"type": ["number", "string", "boolean", "null"]},
          "units": {"type": "string"},
          "artifact_pointers": {"type": "array", "items": {"type": "string"}},
          "source_pointers": {"type": "array", "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "generated_by": {"type": "string"}
        }
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hazard_id", "description", "probability", "severity"],
        "properties": {
          "hazard_id": {"type": "string"},
          "description": {"type": "string"},
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "recommended_action": {"type": "string"}
        }
      }
    }
  }
}
